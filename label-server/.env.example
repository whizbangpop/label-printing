# Cloudflare tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install connector)
TUNNEL_TOKEN=

# Shared secret the print agent presents. Generate with:  openssl rand -hex 32
AGENT_TOKEN=

# Optional but recommended: verify the Cloudflare Access JWT inside the app as well.
# Team domain, e.g. "myteam" or "myteam.cloudflareaccess.com"
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tags, comma separated: the UI app AND the /agent app
CF_ACCESS_AUD=

# Optional tuning
# MAX_COPIES=20
# JOB_TIMEOUT_MS=60000
# TZ=Europe/London
